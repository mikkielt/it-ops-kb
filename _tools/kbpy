#!/bin/sh
# it-ops-kb: the one entry point for hook commands. Finds a Python interpreter and runs a repository script with it.
#
#   sh "<repository>/_tools/kbpy" <script path from the repository root> [arguments...]
#   sh "<repository>/_tools/kbpy" --notice
#
# Every hook in .claude/settings.json, the plugin's plugin.json and .githooks/ calls this file, so no hook names an
# interpreter itself. Claude Code runs a shell-form hook in `sh -c` on macOS and Linux and in Git Bash on Windows
# (kb/public/claude/hooks.md), so a POSIX sh script is the one thing every OS runs the same way.
# - macOS and Linux: `python3`, else `python`, started directly, as the hooks did before this launcher.
# - Windows (OS=Windows_NT, set by Windows in every process): `python3`, `python`, then `py -3`, each only after a
#   probe shows it runs Python 3.11+, since `python3` there is a compatibility alias, not the runtime
#   (kb/public/python/stdlib-windows-portability.md).
# Exit 127 with a message on stderr when no interpreter is found (the pre-push hook lets the push through on 127).
# --notice (a synchronous SessionStart hook): prints nothing when an interpreter is found, else one JSON object with
# `systemMessage`, the one hook output shown to the person (kb/public/claude/hooks.md), and exits 0 either way; every
# other hook exits 127 in silence without Python.
# Tested in _tools/test_portability.py.

[ $# -ge 1 ] || { echo "usage: sh _tools/kbpy <script> [args...] | --notice" >&2; exit 2; }
case $0 in
  */*) here=${0%/*} ;;
  *\\*) here=${0%\\*} ;;  # a Windows path with backslashes only (Git Bash keeps it as given)
  *) here=. ;;
esac
name=$1
script=$here/../$name
shift

# find_py: sets $py to the interpreter command ("py -3" is two words), or returns 1 when there is none
find_py() {
  if [ "${OS:-}" != "Windows_NT" ]; then
    for py in python3 python; do
      command -v "$py" >/dev/null 2>&1 && return 0
    done
  else
    probe='import sys; sys.exit(sys.version_info < (3, 11))'
    for py in python3 python "py -3"; do
      $py -c "$probe" >/dev/null 2>&1 && return 0
    done
  fi
  return 1
}

if [ "$name" = "--notice" ]; then
  find_py && exit 0
  how="install Python 3.11+ and restart the session"
  # the installer beside this file, by its full path: a plugin copy lives under CLAUDE_PLUGIN_ROOT, not the project
  [ "${OS:-}" = "Windows_NT" ] && how="install Python 3.11+ (in PowerShell: $here/install-python.ps1 -CheckOnly, then without -CheckOnly) and restart the session"
  # a JSON string: escape \ and " (a Windows path holds backslashes) in sh alone, since no tool may be on PATH
  rest=$how how=
  while [ -n "$rest" ]; do
    c=${rest%"${rest#?}"}
    rest=${rest#?}
    case $c in \\|\") how="$how\\$c" ;; *) how="$how$c" ;; esac
  done
  printf '{"systemMessage": "it-ops-kb: no Python 3.11+ found (tried python3, python%s): the kb hooks and tools do not run. To fix: %s."}\n' \
    "$([ "${OS:-}" = "Windows_NT" ] && echo ', py -3')" "$how"
  exit 0
fi

if find_py; then
  exec $py "$script" "$@"
fi
echo "it-ops-kb: no Python 3.11+ found (tried python3, python and, on Windows, py -3); $name not run" >&2
exit 127
