#!/bin/sh
# it-ops-kb: run the push gate (the checks `kbgit.py sync --push` runs) before a plain `git push` of a branch.
# Enabled by `python3 _tools/kbgit.py install-hooks` (git config core.hooksPath .githooks). Blocks the push when a
# check fails; `sync` sets KB_GATE_DONE=1 for its own push (it gated already). `git push --no-verify` skips it, and CI
# reports what it would have caught. Without Python (_tools/kbpy exits 127) the push goes through with a warning.
[ "${KB_GATE_DONE:-}" = "1" ] && exit 0
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
sh "$top/_tools/kbpy" _tools/kbgit.py hook pre-push "$@"
rc=$?
if [ "$rc" = 127 ]; then
  echo "kb pre-push: no Python found; push not checked" >&2
  exit 0
fi
exit "$rc"
