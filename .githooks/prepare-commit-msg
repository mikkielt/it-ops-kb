#!/bin/sh
# it-ops-kb: note an --amend, so commit-msg computes the KB-* trailers against HEAD's parent.
# Enabled by `python3 _tools/kbgit.py install-hooks` (git config core.hooksPath .githooks). Never blocks a commit.
# _tools/kbpy finds the interpreter on every OS (python3, python, py -3).
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
sh "$top/_tools/kbpy" _tools/kbgit.py hook prepare-commit-msg "$@" || true
exit 0
