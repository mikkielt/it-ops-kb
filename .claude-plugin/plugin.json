{
  "name": "it-ops-kb",
  "displayName": "it-ops-kb",
  "description": "Read-only access to it-ops-kb: cited facts from official sources on Windows endpoint management (DSC v3, ConfigMgr, Intune, Autopilot, Entra ID, AD, Graph, GPO, Defender, SQL Server, Power BI, GitLab CI, Ansible, Python tooling, baselines, identity, Presidio) and on MCP, Claude Code and AI agents: the kb MCP server, /kb-lookup, /kb-review-workspace, /kb-gap (drafts a gap report to paste), the kb-lookup and kb-reviewer agents and the kb: prompt hook; and for a project with a backlog.json, /sprint, /item and /backlog with the kb-worker agent, which run backlog.py from the plugin against the project's backlog (its SessionStart horizon and intake hooks run only when backlog.json's hooks key names them)",
  "author": {
    "name": "mikkielt",
    "url": "https://gitlab.com/mikkielt"
  },
  "homepage": "https://gitlab.com/mikkielt/it-ops-kb",
  "repository": "git@gitlab.com:mikkielt/it-ops-kb.git",
  "license": "Apache-2.0 AND CC-BY-4.0",
  "keywords": ["windows", "endpoint-management", "intune", "configmgr", "entra-id", "dsc", "mcp", "claude-code", "knowledge-base"],
  "skills": ["./.claude/skills/kb-lookup", "./.claude/skills/kb-review-workspace", "./.claude/skills/kb-gap", "./skills/sprint", "./skills/item", "./skills/backlog"],
  "agents": ["./.claude/agents/kb-lookup.md", "./.claude/agents/kb-reviewer.md", "./agents/worker.md"],
  "mcpServers": {
    "kb": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/_tools/kb_mcp.py"]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/kb_hook.py"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/kb_hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__kb__.*|mcp__plugin_it-ops-kb_kb__.*|WebFetch|mcp__microsoft-learn__.*|mcp__claude-code-docs__.*|mcp__mcp-docs__.*|mcp__plugin_it-ops-kb-docs_.*|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__kb__.*|mcp__plugin_it-ops-kb_kb__.*|WebFetch|mcp__microsoft-learn__.*|mcp__claude-code-docs__.*|mcp__mcp-docs__.*|mcp__plugin_it-ops-kb-docs_.*|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py capture",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" --notice",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py launch",
            "async": true
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py digest --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/backlog.py intake --file --hook --opt-in",
            "async": true,
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "startup|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/backlog.py horizon --hook --opt-in",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/_tools/kbpy\" _tools/querylog.py launch"
          }
        ]
      }
    ]
  }
}
