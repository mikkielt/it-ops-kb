            {
              "$ref": "#/$defs/https:~1~1aka.ms~1dsc~1schemas~1v3~1definitions~1semverReq.json"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ResourceDiscoveryMode": {
      "type": "string",
      "enum": [
        "preDeployment",
        "duringDeployment"
      ]
