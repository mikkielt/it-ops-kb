{
  "$id": "https://aka.ms/dsc/schemas/v3/outputs/config/export.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigurationExportResult",
  "type": "object",
  "properties": {
    "executionInformation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionInformation"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/Metadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/Configuration"
        },
        {
          "type": "null"
        }
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceMessage"
      }
    },
    "hadErrors": {
      "type": "boolean"
    },
    "outputs": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "required": [
    "messages",
    "hadErrors"
  ],
  "$defs": {
    "ExecutionInformation": {
      "type": "object",
      "properties": {
        "duration": {
          "description": "The duration of the configuration operation",
          "type": [
            "string",
            "null"
          ]
        },
        "endDatetime": {
          "description": "The end time of the configuration operation",
          "type": [
            "string",
            "null"
          ]
        },
        "executionType": {
          "description": "The type of execution",
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "description": "The operation being performed",
          "anyOf": [
            {
              "$ref": "#/$defs/Operation"
            },
            {
              "type": "null"
            }
          ]
        },
        "restartRequired": {
          "description": "Indicates what needs to be restarted after the configuration operation",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/RestartRequired"
          }
        },
        "copyLoops": {
          "description": "Copy loop context for resources expanded from copy loops",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "securityContext": {
          "description": "The security context used for the configuration operation",
          "anyOf": [
            {
              "$ref": "#/$defs/SecurityContextKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "startDatetime": {
          "description": "The start time of the configuration operation",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Version of DSC",
          "type": [
            "string",
            "null"
          ]
        },
        "whatIf": {
          "description": "Information about what-if operations performed during this execution, if any"
        }
      }
    },
    "ExecutionKind": {
      "type": "string",
      "enum": [
        "actual",
        "whatIf"
      ]
    },
    "Operation": {
      "type": "string",
      "enum": [
        "get",
        "set",
        "test",
        "export"
      ]
    },
    "RestartRequired": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "process": {
          "$ref": "#/$defs/Process"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "Process": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "id"
      ]
    },
    "SecurityContextKind": {
      "type": "string",
      "enum": [
        "current",
        "elevated",
        "restricted"
      ]
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "Microsoft.DSC": {
          "anyOf": [
            {
              "$ref": "#/$defs/MicrosoftDscMetadata"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "MicrosoftDscMetadata": {
      "type": "object",
      "properties": {
        "duration": {
          "description": "The duration of the configuration operation",
          "type": [
            "string",
            "null"
          ]
        },
        "endDatetime": {
          "description": "The end time of the configuration operation",
          "type": [
            "string",
            "null"
          ]
        },
        "executionType": {
          "description": "The type of execution",
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "description": "The operation being performed",
          "anyOf": [
            {
              "$ref": "#/$defs/Operation"
            },
            {
              "type": "null"
            }
          ]
        },
        "restartRequired": {
          "description": "Indicates what needs to be restarted after the configuration operation",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/RestartRequired"
          }
        },
        "copyLoops": {
          "description": "Copy loop context for resources expanded from copy loops",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "securityContext": {
          "description": "The security context of the configuration operation, can be specified to be required",
          "anyOf": [
            {
              "$ref": "#/$defs/SecurityContextKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "startDatetime": {
          "description": "The start time of the configuration operation",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Version of DSC",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
