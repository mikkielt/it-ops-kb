        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.0.2/bundled/extension/manifest.vscode.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.0.1/bundled/extension/manifest.vscode.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.0.0/bundled/extension/manifest.vscode.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/vNext/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.2/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.2.3/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.2.2/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.2.1/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.2.0/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.1/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.1.3/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.1.2/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.1.1/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.1.0/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.0/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.0.2/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.0.1/extension/manifest.json",
        "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3.0.0/extension/manifest.json"
      ]
    },
    "type": {
      "description": "The namespaced name of the extension.",
      "$ref": "#/$defs/FullyQualifiedTypeName"
    },
    "version": {
      "description": "The version of the extension using semantic versioning.",
      "$ref": "#/$defs/https:~1~1aka.ms~1dsc~1schemas~1v3~1definitions~1semver.json"
    },
    "condition": {
      "description": "An optional condition for the extension to be active.  If the condition evaluates to false, the extension is skipped.",
      "type": [
        "string",
        "null"
      ]
    },
    "deprecationMessage": {
      "description": "An optional message indicating the extension is deprecated. If provided, the message will be shown when the extension is used.",
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "description": "The description of the extension.",
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "description": "Tags for the extension.",
      "$ref": "#/$defs/TagList"
    },
    "discover": {
      "description": "Details how to call the Discover method of the extension.",
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoverMethod"
        },
        {
          "type": "null"
        }
      ]
    },
    "import": {
      "description": "Details how to call the Import method of the extension.",
      "anyOf": [
        {
          "$ref": "#/$defs/ImportMethod"
        },
        {
          "type": "null"
        }
      ]
    },
    "importParameters": {
      "description": "Details how to call the ImportParameters method of the extension.",
      "anyOf": [
        {
          "$ref": "#/$defs/ImportMethod"
        },
        {
          "type": "null"
        }
      ]
    },
    "secret": {
      "description": "Details how to call the Secret method of the extension.",
      "anyOf": [
        {
          "$ref": "#/$defs/SecretMethod"
        },
        {
          "type": "null"
        }
      ]
    },
    "exitCodes": {
      "description": "Mapping of exit codes to descriptions.  Zero is always success and non-zero is always failure.",
      "$ref": "#/$defs/https:~1~1aka.ms~1dsc~1schemas~1v3~1definitions~1exitCodes.json"
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "required": [
    "$schema",
    "type",
    "version"
  ],
  "$defs": {
    "FullyQualifiedTypeName": {
      "title": "Fully qualified type name",
      "description": "Uniquely identifies a DSC resource or extension.",
      "type": "string",
      "pattern": "^\\w+(\\.\\w+)*\\/\\w+$"
    },
    "https://aka.ms/dsc/schemas/v3/definitions/semver.json": {
      "title": "Semantic version",
      "description": "Defines a valid semantic version (semver) as a string.\n\nFor reference, see https://semver.org/",
      "type": "string",
      "pattern": "^(?<major>(?:0|[1-9]\\d*))\\.(?<minor>(?:0|[1-9]\\d*))\\.(?<patch>(?:0|[1-9]\\d*))(?:-(?<prerelease>(?:(?:0|[1-9]\\d*)|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:(?:0|[1-9]\\d*)|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+(?<buildmetadata>[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "TagList": {
      "title": "Tag list",
      "description": "Defines a set of short search terms for a DSC resource or extension.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "title": "Tag",
        "description": "Defines a short search term for a DSC resource or extension.",
        "type": "string",
        "pattern": "^\\w+$"
      }
    },
    "DiscoverMethod": {
      "type": "object",
      "properties": {
        "executable": {
          "description": "The command to run to get the state of the resource.",
          "type": "string"
        },
        "args": {
          "description": "The arguments to pass to the command to perform a Get.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/DiscoverArgKind"
          }
        }
      },
      "required": [
        "executable"
      ]
    },
    "DiscoverArgKind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "extensionsArg": {
              "description": "The argument that accepts the extensions list.  The extensions list will be passed as a comma separated list of extensions.",
              "type": "string"
            },
            "includeQuotes": {
              "description": "Whether to include quotes around the extensions list.  If true, the extensions list will be passed as a quoted string.",
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "extensionsArg"
          ]
        }
      ]
    },
    "ImportMethod": {
      "type": "object",
      "properties": {
        "fileExtensions": {
          "description": "The extensions to import.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executable": {
          "description": "The command to run to get the state of the resource.",
          "type": "string"
        },
        "args": {
          "description": "The arguments to pass to the command to perform an Import.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ImportArgKind"
          }
        },
        "output": {
          "description": "Enables modifying the resulting output from STDOUT after running the import command.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fileExtensions",
        "executable"
      ]
    },
    "ImportArgKind": {
      "anyOf": [
        {
          "description": "The argument is a string.",
          "type": "string"
        },
        {
          "description": "The argument accepts the file path.",
          "type": "object",
          "properties": {
            "fileArg": {
              "description": "The argument that accepts the file path.",
              "type": "string"
            }
          },
          "required": [
            "fileArg"
          ]
        }
      ]
    },
    "SecretMethod": {
      "type": "object",
      "properties": {
        "executable": {
          "description": "The command to run to get the state of the resource.",
          "type": "string"
        },
        "args": {
          "description": "The arguments to pass to the command to perform a Get.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/SecretArgKind"
          }
        }
      },
      "required": [
        "executable"
      ]
    },
    "SecretArgKind": {
      "anyOf": [
        {
          "description": "The argument is a string.",
          "type": "string"
        },
        {
          "description": "The argument accepts the secret name.",
          "type": "object",
          "properties": {
            "nameArg": {
              "description": "The argument that accepts the secret name.",
              "type": "string"
            }
          },
          "required": [
            "nameArg"
          ]
        },
        {
          "description": "The argument accepts the vault name.",
          "type": "object",
          "properties": {
            "vaultArg": {
              "description": "The argument that accepts the vault name.",
              "type": "string"
            }
          },
          "required": [
            "vaultArg"
          ]
        }
      ]
    },
    "https://aka.ms/dsc/schemas/v3/definitions/exitCodes.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Exit codes",
      "description": "Defines a map of valid exit codes for operation commands.",
      "type": "object",
      "examples": [
        {
          "0": "Success",
          "1": "Invalid parameter",
          "2": "Invalid input",
          "3": "Registry error",
          "4": "JSON serialization failed"
        }
      ],
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^-?[0-9]+$"
      },
      "patternProperties": {
        "^-?[0-9]+$": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false,
      "default": {
        "0": "Success",
        "1": "Error"
      }
    }
  }
}
