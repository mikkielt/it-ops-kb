{
  "item_dir": "kb/_self/backlog",
  "id_prefixes": {
    "epic": "EP",
    "story": "ST",
    "task": "TK",
    "subtask": "SB",
    "bug": "BG",
    "sprint": "SP"
  },
  "always_in_scope": [
    "kb/_self/backlog/**",
    "kb/*/_coverage.csv",
    "kb/*/_coverage.md"
  ],
  "review_checks": [
    {
      "run": [
        "python3",
        "_tools/backlog.py",
        "check"
      ]
    },
    {
      "run": [
        "python3",
        "_tools/tests.py"
      ]
    },
    {
      "run": [
        "python3",
        "_tools/rag.py",
        "eval",
        "--file",
        "kb/public/_retrieval/lookup_heldout.csv",
        "--root",
        "public",
        "--min",
        "86",
        "--max-false-good",
        "8"
      ]
    }
  ],
  "research_checks": [
    {
      "run": [
        "python3",
        "_tools/backlog.py",
        "researched",
        "{id}"
      ]
    }
  ],
  "land_stale": [
    "_tools/selfdoc.py",
    "stale",
    "--since"
  ],
  "land_eval": [
    "_tools/rag.py",
    "eval"
  ],
  "land_lint": [
    ".claude/skills/kb-verify/lint.py"
  ],
  "lane_module": "kblane",
  "land_push": [
    "_tools/kbgit.py",
    "sync",
    "--push"
  ],
  "worktree_dir": ".claude/worktrees",
  "scratch_dir": "_cache/scratch",
  "forge": "gitlab",
  "forge_project": "",
  "stop_finished": false,
  "trackers": {},
  "docs_map": "kb/_self/map.csv",
  "kb_root": "_self",
  "repositories": {}
}
